#. Plugin Name of the plugin
#: wc-begateway.php
msgid "BeGateway Payment Gateway for WooCommerce"
msgstr "WooCommerce BeGateway Payment Gateway"

#. Description of the plugin
#: wc-begateway.php
msgid "Extends WooCommerce with BeGateway payment gateway."
msgstr "Пашырае WooCommerce плацёжным шлюзам BeGateway."

#. Author of the plugin
#: wc-begateway.php includes/class-wc-gateway-begateway.php:51
msgid "BeGateway"
msgstr "BeGateway"

#. translators: %1$s is replaced with the error message
#: includes/class-wc-gateway-begateway-subscriptions.php:74
#, php-format
msgid "Error to process subscription payment with the error: %s"
msgstr "Памылка апрацоўкі аплаты падпіскі: %s"

