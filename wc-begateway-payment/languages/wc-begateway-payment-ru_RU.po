#. Plugin Name of the plugin
#: wc-begateway.php
msgid "BeGateway Payment Gateway for WooCommerce"
msgstr "Платёжный шлюз WooCommerce BeGateway"

#. Description of the plugin
#: wc-begateway.php
msgid "Extends WooCommerce with BeGateway payment gateway."
msgstr "Расширение WooCommerce для платежного шлюза BeGateway"

#. Author of the plugin
#: wc-begateway.php includes/class-wc-gateway-begateway.php:51
msgid "BeGateway"
